<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>USAID AI</title>
<style>
:root{--bg:#080d18;--p:#111b2c;--line:#293750;--txt:#edf4ff;--mut:#9cabc2;--a:#68e5f4;--b:#8c9cff}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 70% 0,#202c50,transparent 45%),var(--bg);color:var(--txt);font:15px system-ui,Arial}.app{min-height:100vh;display:grid;grid-template-columns:235px 1fr}.side{background:#0b111e;border-right:1px solid var(--line);padding:18px;display:flex;flex-direction:column;gap:16px}.brand{display:flex;gap:10px;align-items:center;font-weight:800;font-size:19px}.logo{background:linear-gradient(135deg,var(--a),var(--b));color:#07101b;border-radius:13px;padding:9px 13px}.brand small{display:block;font-size:10px;color:var(--mut);font-weight:500}.nav{display:grid;gap:5px}.nav button,.new,.upgrade{border:1px solid transparent;background:transparent;color:var(--mut);text-align:left;padding:11px;border-radius:11px;cursor:pointer}.nav button.active,.nav button:hover{background:#19263d;color:white;border-color:var(--line)}.new,.upgrade{background:var(--p);border-color:var(--line);color:white}.upgrade{margin-top:auto;text-align:center;background:linear-gradient(110deg,#263d68,#443263)}.main{min-width:0}.top{height:62px;display:flex;align-items:center;justify-content:space-between;padding:0 25px;border-bottom:1px solid var(--line);position:sticky;top:0;background:#0b111deF;z-index:2}.pill,.tag{border:1px solid var(--line);border-radius:30px;padding:6px 11px;color:var(--mut);font-size:11px}.content{max-width:1050px;margin:auto;padding:28px}.page{display:none}.page.active{display:block}.eyebrow{color:var(--a);font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700}.hero{padding:25px 0}.hero h1{font-size:clamp(32px,5vw,52px);line-height:1.1;margin:12px 0}.grad{background:linear-gradient(90deg,var(--a),#b6c2ff,#c59aff);color:transparent;background-clip:text}.muted,p{color:var(--mut)}.grid,.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.tile,.panel{background:linear-gradient(145deg,#152137,#101827);border:1px solid var(--line);border-radius:16px;padding:18px}.tile{cursor:pointer}.tile:hover{border-color:#7187c1;transform:translateY(-2px)}.tile h3{margin:9px 0 4px}.tile p{font-size:13px;margin:0}.tile strong{font-size:25px}.action,.secondary{padding:11px 15px;border:0;border-radius:10px;cursor:pointer;font-weight:700}.action{background:linear-gradient(110deg,var(--a),var(--b));color:#08101b}.secondary{background:#263650;color:white;border:1px solid var(--line)}.chat{height:min(68vh,700px);min-height:430px;border:1px solid var(--line);border-radius:17px;display:flex;flex-direction:column;overflow:hidden;background:#0b1422}.chathead,.composer{padding:13px 16px;border-bottom:1px solid var(--line)}.chathead{display:flex;justify-content:space-between}.online{color:#7de5b4;font-size:11px}.messages{padding:18px;display:flex;flex-direction:column;gap:13px;overflow:auto;flex:1}.msg{max-width:80%;padding:12px 15px;border-radius:14px;white-space:pre-wrap}.bot{background:#18263d;border:1px solid #30415f;align-self:flex-start}.user{background:#45558e;align-self:flex-end}.msg small{display:block;font-size:10px;color:#b9c6dc;margin-top:5px}.composer{border:0;border-top:1px solid var(--line);background:#101a2a}.compose{display:flex;gap:7px;align-items:end;background:#1a263a;border:1px solid #354661;border-radius:13px;padding:8px}.compose textarea{flex:1;min-height:40px;max-height:110px;resize:vertical;background:transparent;color:white;border:0;outline:0;padding:8px}.compose button{border:0;border-radius:9px;padding:10px;background:#2b3c59;color:white;cursor:pointer}.compose .send{background:linear-gradient(110deg,var(--a),var(--b));color:#07101b;font-weight:900}.hint{font-size:10px;color:var(--mut);margin:7px}.field{width:100%;padding:12px;background:#0b1422;color:white;border:1px solid var(--line);border-radius:10px;margin:7px 0 14px}.result{background:#0b1422;border:1px solid var(--line);border-radius:11px;padding:14px;white-space:pre-wrap;min-height:60px}.voiceorb{width:130px;height:130px;border-radius:100%;margin:25px auto;background:radial-gradient(circle at 30% 25%,#b5fbff,#718bff 50%,#533e8c);box-shadow:0 0 50px #708cff55;display:grid;place-items:center;font-size:40px}.center{text-align:center}.price{font-size:27px;font-weight:800;margin:10px 0}.plan li{color:var(--mut);margin:8px 0;font-size:13px}.foot{text-align:center;border-top:1px solid var(--line);padding:20px;color:#7787a0;font-size:11px}
@media(max-width:760px){.app{display:block}.side{position:sticky;top:0;z-index:5;padding:10px;border:0;border-bottom:1px solid var(--line)}.brand{padding:0 4px 7px}.nav{display:flex;overflow:auto}.nav button{white-space:nowrap;font-size:12px;padding:8px}.upgrade,.new{display:none}.content{padding:18px 13px}.grid,.plans{grid-template-columns:1fr 1fr}.top{height:50px;padding:0 13px}.msg{max-width:92%}}@media(max-width:430px){.grid,.plans{grid-template-columns:1fr}}
</style></head><body><div class="app"><aside class="side"><div class="brand"><div class="logo">U</div><div>USAID AI<small>INTELLIGENCE WORKSPACE</small></div></div><button class="new" onclick="page('chat')">＋ New conversation</button><nav class="nav">
<button class="active" data-id="home" onclick="page('home')">⌂ Home</button><button data-id="chat" onclick="page('chat')">✧ AI Chat</button><button data-id="study" onclick="page('study')">▤ Study</button><button data-id="business" onclick="page('business')">▣ Business</button><button data-id="voice" onclick="page('voice')">◉ Voice Assistant</button><button data-id="image" onclick="page('image')">▧ Image Studio</button><button data-id="writer" onclick="page('writer')">✎ AI Writer</button><button data-id="translate" onclick="page('translate')">文 Translator</button><button data-id="upgrade" onclick="page('upgrade')">♢ Upgrade</button></nav><button class="upgrade" onclick="page('upgrade')">✦ Explore Upgrade</button></aside>
<main class="main"><header class="top"><b id="title">Home / USAID AI</b><span class="pill">● Preview mode</span></header><div class="content">
<section class="page active" id="home"><div class="hero"><div class="eyebrow">One workspace. Many possibilities.</div><h1>Your ideas,<br><span class="grad">powered by intelligence.</span></h1><p>Chat, learn, create and organise your work in one clean space.</p><button class="action" onclick="page('chat')">Start a conversation →</button></div><div class="grid">
<div class="tile" onclick="page('chat')"><strong>✧</strong><h3>AI Chat</h3><p>Ask questions and share gallery images.</p></div><div class="tile" onclick="page('study')"><strong>▤</strong><h3>Study Room</h3><p>Learn topics step by step.</p></div><div class="tile" onclick="page('business')"><strong>▣</strong><h3>Business Desk</h3><p>Plan projects and organise tasks.</p></div><div class="tile" onclick="page('voice')"><strong>◉</strong><h3>Voice Assistant</h3><p>Speak and listen with browser voice tools.</p></div><div class="tile" onclick="page('image')"><strong>▧</strong><h3>Image Studio</h3><p>Preview uploads and prepare creative prompts.</p></div><div class="tile" onclick="page('writer')"><strong>✎</strong><h3>AI Writer</h3><p>Draft messages, captions and descriptions.</p></div></div></section>
<section class="page" id="chat"><div class="eyebrow">Your AI companion</div><h2>Conversation</h2><div class="chat"><div class="chathead"><div><b>USAID Assistant</b><div class="online">● Backend not connected yet</div></div><button class="secondary" onclick="clearChat()">New chat</button></div><div class="messages" id="messages"><div class="msg bot">Assalamualaikum! Main USAID Assistant hoon. Apna sawal likhein ya gallery se image attach karein. Gemini connect hone ke baad yahan real AI replies aayenge.<small>USAID AI · now</small></div></div><div class="composer"><div class="compose"><input id="file" type="file" accept="image/*" hidden onchange="attach(event)"><button onclick="document.getElementById('file').click()">＋</button><textarea id="prompt" placeholder="Message USAID Assistant..." onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();send()}"></textarea><button onclick="voice()">🎙</button><button class="send" onclick="send()">➤</button></div><div class="hint">Preview only. Messages are not sent to Gemini until secure backend setup.</div></div></div></section>
<section class="page" id="study"><div class="eyebrow">Learn with clarity</div><h2>Study Room</h2><div class="panel">Topic<input class="field" id="topic" placeholder="e.g. Algebra, English grammar"><button class="action" onclick="prep('topic','studyout','Explain this topic step by step in simple language: ')">Prepare study prompt</button><div class="result" id="studyout">Prompt appears here.</div></div></section>
<section class="page" id="business"><div class="eyebrow">Plan and organise</div><h2>Business Desk</h2><div class="panel">Project or idea<textarea class="field" id="biz" rows="4" placeholder="Describe your project..."></textarea><button class="action" onclick="prep('biz','bizout','Create a beginner-friendly project plan for: ')">Prepare plan prompt</button><div class="result" id="bizout">Prompt appears here.</div></div></section>
<section class="page" id="voice"><div class="eyebrow">Hands-free interaction</div><h2>Voice Assistant</h2><div class="panel center"><div class="voiceorb">◉</div><h3>Talk to USAID</h3><p>Browser speech input and voice playback. Full live Siri-style AI needs a connected backend and audio service.</p><button class="action" onclick="voice()">🎙 Start speaking</button> <button class="secondary" onclick="say('Assalamualaikum! Welcome to USAID AI. How can I help you today?')">▶ Test voice</button><div class="result" id="voiceout" style="margin-top:16px">Your speech will appear here.</div></div></section>
<section class="page" id="image"><div class="eyebrow">Creative workspace</div><h2>Image Studio</h2><div class="panel"><input class="field" type="file" accept="image/*" onchange="imagePreview(event)"><div class="result" id="imageout">Selected image preview appears here.</div><textarea class="field" rows="3" placeholder="Describe the image you want to create..."></textarea><p>Image generation needs a separate image model connection.</p></div></section>
<section class="page" id="writer"><div class="eyebrow">Words that work</div><h2>AI Writer</h2><div class="panel">What should be written?<textarea class="field" id="writing" rows="4" placeholder="Write a welcome message for my channel..."></textarea><button class="action" onclick="prep('writing','writerout','Write a polished draft for: ')">Prepare writing prompt</button><div class="result" id="writerout">Prompt appears here.</div></div></section>
<section class="page" id="translate"><div class="eyebrow">Speak across languages</div><h2>Translator</h2><div class="panel"><textarea class="field" id="trans" rows="4" placeholder="Enter text..."></textarea><select class="field" id="lang"><option>Urdu</option><option>English</option><option>Arabic</option><option>Chinese</option><option>Sindhi</option><option>Pashto</option></select><button class="action" onclick="document.getElementById('transout').textContent='Translate into '+lang.value+': '+trans.value">Prepare translation prompt</button><div class="result" id="transout">Prompt appears here.</div></div></section>
<section class="page" id="upgrade"><div class="eyebrow">More room to create</div><h2>Upgrade USAID AI</h2><p>Plan and message quota preview. Real limits and subscriptions activate only after secure backend setup.</p><div class="plans"><div class="panel plan"><span class="tag">STARTER</span><h3>Free</h3><div class="price">$0</div><ul><li>Planned daily message limit</li><li>Basic chat and tools</li></ul><button class="secondary" disabled>Preview plan</button></div><div class="panel plan"><span class="tag">PLUS</span><h3>Plus</h3><div class="price">Coming soon</div><ul><li>Higher message allowance</li><li>More tool usage</li></ul><button class="secondary" disabled>Not active</button></div><div class="panel plan"><span class="tag">PRO</span><h3>Pro</h3><div class="price">Coming soon</div><ul><li>Largest planned quota</li><li>Advanced workspace</li></ul><button class="secondary" disabled>Not active</button></div></div><div class="panel" style="margin-top:15px"><h3>Payment & Support</h3><p>USDT is shown as a planned payment option only. No wallet address or payment collection is enabled. Any real payment setup must be managed by an authorised adult using a compliant provider.</p><b>Contact:</b> <a style="color:var(--a)" href="mailto:k64125155@gmail.com">k64125155@gmail.com</a><p>Never email passwords, API keys or private wallet details.</p></div></section>
</div><footer class="foot">USAID AI · Interface preview · Secure AI connection required for live answers</footer></main></div>
<script>
let img=null;function page(id){document.querySelectorAll('.page').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.id===id));document.getElementById('title').textContent=id[0].toUpperCase()+id.slice(1)+' / USAID AI';window.scrollTo(0,0)}
function add(t,who='user',src=null){let d=document.createElement('div');d.className='msg '+who;d.textContent=t;if(src){let im=document.createElement('img');im.src=src;im.style.maxWidth='160px';im.style.display='block';im.style.marginTop='8px';d.appendChild(im)}let s=document.createElement('small');s.textContent=who==='user'?'You · now':'USAID AI · preview';d.appendChild(s);messages.appendChild(d);messages.scrollTop=messages.scrollHeight}
function send(){let v=prompt.value.trim();if(!v&&!img)return;add(v||'Image attached','user',img);prompt.value='';img=null;add('Message receive ho gaya. Yeh abhi preview mode hai; real AI jawab ke liye Gemini ko secure backend se connect karna hoga. API key ko HTML ya GitHub par kabhi public nahi rakhna.','bot')}
function attach(e){let f=e.target.files[0];if(f){let r=new FileReader();r.onload=()=>{img=r.result;prompt.placeholder='Image attached. Add a message...'};r.readAsDataURL(f)}}
function clearChat(){messages.innerHTML='';img=null}
function prep(input,out,prefix){document.getElementById(out).textContent=prefix+document.getElementById(input).value+'\n\nActual AI response will appear after Gemini connection.'}
function say(t){if(!speechSynthesis){alert('Voice playback unavailable');return}let u=new SpeechSynthesisUtterance(t);speechSynthesis.cancel();speechSynthesis.speak(u)}
function voice(){let S=window.SpeechRecognition||window.webkitSpeechRecognition;if(!S){voiceout.textContent='Speech recognition is not supported in this browser. Type in chat instead.';return}let r=new S();r.lang='en-US';r.onresult=e=>{let t=e.results[0][0].transcript;voiceout.textContent=t;prompt.value=t;page('chat')};r.onerror=()=>voiceout.textContent='Microphone permission or speech recognition failed.';r.start()}
function imagePreview(e){let f=e.target.files[0];if(!f)return;let u=URL.createObjectURL(f),im=document.createElement('img');im.src=u;im.style.maxWidth='100%';im.style.maxHeight='280px';imageout.innerHTML='';imageout.appendChild(im)}
</script></body></html>
