<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080d1d">
<title>USAID AI — Intelligence Workspace</title>
<style>
:root{--bg:#080d1d;--panel:#10182b;--panel2:#141f36;--line:#253452;--text:#edf4ff;--muted:#91a3c2;--blue:#62a8ff;--cyan:#52e2df;--purple:#a78bfa}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 20% 0%,#15264a 0,transparent 38%),var(--bg);color:var(--text);font:15px Inter,system-ui,Arial,sans-serif;min-height:100vh}
button,input,textarea{font:inherit}button{cursor:pointer;color:inherit}.app{display:grid;grid-template-columns:250px 1fr;min-height:100vh}
.sidebar{background:#0b1223dd;border-right:1px solid var(--line);padding:20px 14px;display:flex;flex-direction:column;gap:18px}
.brand{display:flex;align-items:center;gap:11px;padding:4px 8px 16px}.logo{width:39px;height:39px;border-radius:13px;background:linear-gradient(135deg,var(--blue),var(--cyan));display:grid;place-items:center;color:#06101e;font-weight:900;font-size:20px;box-shadow:0 0 28px #52e2df55}.brand b{font-size:17px;letter-spacing:1.5px}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:2px;margin-top:2px}
.newchat{border:1px solid #4777b5;background:linear-gradient(110deg,#1b3c68,#172a49);padding:12px;border-radius:12px;text-align:left;font-weight:700}.navlabel{font-size:10px;color:#7387a9;letter-spacing:1.7px;padding:8px 10px 2px}.nav{display:grid;gap:5px}.nav button{background:transparent;border:1px solid transparent;text-align:left;padding:10px 11px;border-radius:10px;color:#b8c7df;display:flex;gap:11px;align-items:center}.nav button:hover,.nav button.active{background:#172640;border-color:#2b466c;color:white}.ico{width:20px;text-align:center;font-size:17px}.sidefoot{margin-top:auto;border-top:1px solid var(--line);padding:14px 8px;color:var(--muted);font-size:12px;line-height:1.6}
.main{min-width:0;display:flex;flex-direction:column}.top{height:68px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 25px;background:#0b122399;backdrop-filter:blur(12px)}.top strong{font-size:14px}.status{font-size:11px;color:#8de5c2;border:1px solid #285b50;background:#102c2a;padding:6px 10px;border-radius:20px}
.content{padding:26px;max-width:1200px;width:100%;margin:0 auto}.page{display:none}.page.active{display:block}.eyebrow{color:var(--cyan);font-size:11px;letter-spacing:2px;font-weight:800}.hero{padding:28px;border:1px solid #29466e;border-radius:22px;background:linear-gradient(125deg,#14294a,#111a30 65%,#1d2143);position:relative;overflow:hidden}.hero:after{content:"✦";position:absolute;right:35px;top:10px;font-size:110px;color:#6cbfff18}.hero h1{font-size:clamp(28px,5vw,46px);margin:10px 0}.gradient{background:linear-gradient(90deg,#7db8ff,#62e8df,#b69aff);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{color:#afc1df;max-width:650px;line-height:1.7}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(205px,1fr));gap:14px;margin-top:20px}.tile{background:linear-gradient(145deg,#131f36,#0f1729);border:1px solid var(--line);padding:19px;border-radius:16px;text-align:left;min-height:140px;transition:.2s}.tile:hover{transform:translateY(-3px);border-color:#5a8bc8}.tile .big{font-size:25px}.tile h3{margin:12px 0 5px;font-size:15px}.tile p{margin:0;color:var(--muted);font-size:12px;line-height:1.55}
.chatbox{border:1px solid var(--line);border-radius:18px;background:#0d1628;overflow:hidden;display:flex;flex-direction:column;height:min(72vh,720px);min-height:490px}.chathead{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.chathead small{color:var(--muted)}.messages{padding:22px;overflow:auto;flex:1;display:flex;flex-direction:column;gap:18px}.welcome{text-align:center;margin:auto;max-width:520px}.orb{width:64px;height:64px;border-radius:22px;margin:0 auto 15px;background:linear-gradient(135deg,#6baaff,#4de0d8);display:grid;place-items:center;color:#06101e;font-size:28px;box-shadow:0 0 45px #5ab8ff44}.welcome h2{font-size:25px;margin:6px}.welcome p{color:var(--muted);line-height:1.6}.msg{max-width:82%;padding:13px 16px;border-radius:16px;line-height:1.6;white-space:pre-wrap}.msg.user{align-self:flex-end;background:#1d416e;border:1px solid #37679c}.msg.ai{align-self:flex-start;background:#172238;border:1px solid #2a3b58}.msg .who{font-size:10px;color:#9bb8df;letter-spacing:1px;margin-bottom:5px}.composer{border-top:1px solid var(--line);padding:13px;display:flex;gap:9px;align-items:flex-end;background:#101a2d}.composer textarea{flex:1;resize:none;min-height:46px;max-height:130px;border:1px solid #304566;background:#0a1221;color:white;border-radius:13px;padding:13px;outline:none}.composer textarea:focus{border-color:var(--blue)}.round{width:43px;height:43px;border-radius:12px;border:1px solid #36577e;background:#1a3558;font-size:18px}.send{background:linear-gradient(135deg,#69aaff,#53ded8);color:#071322;border:0;font-weight:900}.hint{font-size:10px;color:#8294b1;padding:0 16px 10px;background:#101a2d}
.sectiontitle{font-size:27px;margin:8px 0}.sub{color:var(--muted);line-height:1.65;max-width:760px}.toolgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:13px;margin-top:20px}.tool{padding:17px;border-radius:15px;border:1px solid var(--line);background:var(--panel)}.tool b{display:block;margin:8px 0}.tool p{font-size:12px;color:var(--muted);line-height:1.5}.pill{font-size:10px;color:#8fe8d8;background:#13332f;border:1px solid #28574f;border-radius:20px;padding:4px 8px}
.field{display:grid;gap:8px;margin:16px 0}.field label{font-size:12px;color:#a9bbd7}.field input,.field textarea,.field select{width:100%;background:#0b1425;border:1px solid #2b3f5e;border-radius:11px;color:white;padding:12px}.action{border:0;border-radius:11px;background:linear-gradient(100deg,#65aaff,#58ded9);color:#071322;padding:11px 16px;font-weight:800}.output{margin-top:14px;padding:14px;border:1px dashed #395577;border-radius:12px;color:#b9c9e2;min-height:55px;white-space:pre-wrap}
.upload{border:1px dashed #5275a0;border-radius:14px;padding:22px;text-align:center;color:#a8bddb;background:#101b30}.upload input{max-width:100%;margin-top:12px}.preview{max-width:180px;max-height:160px;border-radius:12px;display:block;margin:12px auto}
.notice{margin-top:18px;border:1px solid #5a4d2d;background:#292315;color:#e8d7a8;border-radius:12px;padding:12px 14px;font-size:12px;line-height:1.6}
@media(max-width:760px){.app{grid-template-columns:1fr}.sidebar{position:sticky;top:0;z-index:5;padding:9px 10px;border-right:0;border-bottom:1px solid var(--line);gap:8px}.brand{padding:2px 6px}.logo{width:32px;height:32px}.brand b{font-size:14px}.newchat{display:none}.navlabel,.sidefoot{display:none}.nav{display:flex;overflow-x:auto;gap:4px}.nav button{white-space:nowrap;padding:8px 10px;font-size:12px}.top{height:48px;padding:0 15px}.content{padding:15px}.chatbox{height:calc(100dvh - 175px);min-height:430px}.messages{padding:14px}.msg{max-width:92%}.hero{padding:22px}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
 <div class="brand"><div class="logo">U</div><div><b>USAID AI</b><small>INTELLIGENCE OS</small></div></div>
 <button class="newchat" onclick="newChat()">＋ &nbsp; New conversation</button>
 <div class="navlabel">WORKSPACE</div>
 <nav class="nav">
  <button class="active" data-page="home" onclick="showPage('home',this)"><span class="ico">⌂</span>Home</button>
  <button data-page="chat" onclick="showPage('chat',this)"><span class="ico">◉</span>AI Chat</button>
  <button data-page="study" onclick="showPage('study',this)"><span class="ico">▤</span>Study & Learn</button>
  <button data-page="image" onclick="showPage('image',this)"><span class="ico">▧</span>Image Studio</button>
  <button data-page="voice" onclick="showPage('voice',this)"><span class="ico">♫</span>Voice Studio</button>
  <button data-page="business" onclick="showPage('business',this)"><span class="ico">▣</span>Business</button>
  <button data-page="tools" onclick="showPage('tools',this)"><span class="ico">✣</span>AI Tools</button>
 </nav>
 <div class="sidefoot">Your creative intelligence workspace.<br>Built to grow, one feature at a time.</div>
</aside>
<main class="main">
 <header class="top"><strong id="topTitle">Home dashboard</strong><span class="status">● SYSTEM ONLINE · PREVIEW</span></header>
 <div class="content">
  <section class="page active" id="home">
   <div class="hero"><div class="eyebrow">WELCOME TO YOUR AI WORKSPACE</div><h1>Think bigger. <span class="gradient">Create smarter.</span></h1><p>One futuristic workspace for conversations, learning, images, voice, business and productivity. Choose a section to begin.</p><button class="action" onclick="showPage('chat')">Start a conversation →</button></div>
   <div class="cards">
    <button class="tile" onclick="showPage('chat')"><div class="big">◉</div><h3>AI Conversation</h3><p>Chat interface with message history, replies and image attachments.</p></button>
    <button class="tile" onclick="showPage('study')"><div class="big">▤</div><h3>Study & Learn</h3><p>Get help understanding subjects, lessons and practice topics.</p></button>
    <button class="tile" onclick="showPage('image')"><div class="big">▧</div><h3>Image Studio</h3><p>Prepare image prompts and preview pictures you select.</p></button>
    <button class="tile" onclick="showPage('voice')"><div class="big">♫</div><h3>Voice Studio</h3><p>Try browser speech input and read text aloud where supported.</p></button>
    <button class="tile" onclick="showPage('business')"><div class="big">▣</div><h3>Business Desk</h3><p>Plan ideas, write descriptions and organize a project.</p></button>
    <button class="tile" onclick="showPage('tools')"><div class="big">✣</div><h3>Tool Universe</h3><p>Writing, translation, coding, research and idea tools.</p></button>
   </div>
   <div class="notice">Preview mode: the interface and local browser features work, but ChatGPT-level answers, AI image generation and advanced tools need secure AI services connected by a backend. This page does not pretend those services are already live.</div>
  </section>
  <section class="page" id="chat">
   <div class="eyebrow">YOUR AI COMPANION</div><h2 class="sectiontitle">AI Chat</h2><p class="sub">Send a message, attach a picture from your gallery, and keep the conversation visible. The demo reply explains what is not connected yet.</p>
   <div class="chatbox"><div class="chathead"><div><b>✦ USAID Assistant</b><br><small>General chat · Preview mode</small></div><button class="round" title="New chat" onclick="newChat()">＋</button></div>
    <div class="messages" id="messages"><div class="welcome" id="welcome"><div class="orb">✦</div><h2>How can I help today?</h2><p>Ask about study, ideas, business, writing or technology. You can also attach a picture.</p></div></div>
    <div class="composer"><label class="round" title="Attach image" style="display:grid;place-items:center">＋<input id="photo" type="file" accept="image/*" hidden onchange="attachImage(event)"></label><textarea id="chatInput" rows="1" placeholder="Message USAID AI…" onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMessage()}"></textarea><button class="round send" onclick="sendMessage()">➤</button></div><div class="hint">Enter to send · Shift + Enter for a new line · Gallery images can be attached</div>
   </div>
   <div id="attachment"></div>
  </section>
  <section class="page" id="study"><div class="eyebrow">LEARNING LAB</div><h2 class="sectiontitle">Study & Learn</h2><p class="sub">Build understanding step by step. Choose a subject and write what you want to learn.</p><div class="field"><label>Subject</label><select id="subject"><option>Mathematics</option><option>English</option><option>Science</option><option>Computer & AI</option><option>Business</option><option>Other</option></select></div><div class="field"><label>What do you want help with?</label><textarea id="studyText" rows="4" placeholder="e.g. Explain Python variables in simple Urdu…"></textarea></div><button class="action" onclick="prepare('studyText','Study request')">Prepare learning request</button><div class="output" id="studyOut">Your learning request will appear here.</div></section>
  <section class="page" id="image"><div class="eyebrow">CREATIVE LAB</div><h2 class="sectiontitle">Image Studio</h2><p class="sub">Select an image from your gallery to preview it, or write a prompt for an image-generation service.</p><div class="upload">▧<br><b>Choose an image from your gallery</b><br><input type="file" accept="image/*" onchange="previewImage(event)"><img id="imagePreview" class="preview" hidden></div><div class="field"><label>Image idea / prompt</label><textarea id="imagePrompt" rows="4" placeholder="Describe the image you want to create…"></textarea></div><button class="action" onclick="prepare('imagePrompt','Image prompt')">Prepare image prompt</button><div class="output" id="imageOut">Your prompt will appear here. Actual AI image generation needs an image model connection.</div></section>
  <section class="page" id="voice"><div class="eyebrow">VOICE INTERFACE</div><h2 class="sectiontitle">Voice Studio</h2><p class="sub">Use your browser's available speech features. This is not yet a live, full-duplex AI voice conversation.</p><div class="field"><label>Speak to text</label><button class="action" onclick="listen()">🎙 Start voice input</button><div class="output" id="voiceInput">Your recognized speech will appear here if your browser supports speech recognition.</div></div><div class="field"><label>Text to speak</label><textarea id="speakText" rows="3" placeholder="Type something to hear it spoken…"></textarea><button class="action" onclick="speak()">▶ Speak aloud</button></div></section>
  <section class="page" id="business"><div class="eyebrow">IDEA TO EXECUTION</div><h2 class="sectiontitle">Business Desk</h2><p class="sub">Organize a business idea, customer message, product description or simple action plan.</p><div class="field"><label>Project / business idea</label><input id="bizName" placeholder="Your project name or idea"></div><div class="field"><label>What do you need?</label><textarea id="bizText" rows="4" placeholder="Describe your goal…"></textarea></div><button class="action" onclick="businessPlan()">Prepare business brief</button><div class="output" id="bizOut">Your business brief will appear here.</div></section>
  <section class="page" id="tools"><div class="eyebrow">THE TOOL UNIVERSE</div><h2 class="sectiontitle">AI Tools</h2><p class="sub">A growing collection of focused assistants. Select a tool to open its workspace.</p><div class="toolgrid">
   <div class="tool"><span>✍️</span><b>AI Writer</b><p>Draft posts, messages, descriptions and outlines.</p><button class="action" onclick="openTool('AI Writer')">Open tool</button></div>
   <div class="tool"><span>🌐</span><b>Translator</b><p>Prepare text for translation between languages.</p><button class="action" onclick="openTool('Translator')">Open tool</button></div>
   <div class="tool"><span>💻</span><b>Code Assistant</b><p>Explain code and plan coding tasks.</p><button class="action" onclick="openTool('Code Assistant')">Open tool</button></div>
   <div class="tool"><span>🔎</span><b>Research Assistant</b><p>Structure research questions and summaries.</p><button class="action" onclick="openTool('Research Assistant')">Open tool</button></div>
   <div class="tool"><span>💡</span><b>Idea Generator</b><p>Brainstorm concepts and creative directions.</p><button class="action" onclick="openTool('Idea Generator')">Open tool</button></div>
   <div class="tool"><span>🧰</span><b>Custom Tool Hub</b><p>A place to add verified tools and integrations later.</p><button class="action" onclick="openTool('Custom Tool Hub')">Open tool</button></div>
  </div><div class="notice">External tools are not secretly connected. Each integration must be added safely and clearly, with permission and a secure backend.</div></section>
 </div>
</main>
</div>
<script>
let attachedData=null;
function showPage(id,btn){document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));document.getElementById('topTitle').textContent=({home:'Home dashboard',chat:'AI Conversation',study:'Study & Learn',image:'Image Studio',voice:'Voice Studio',business:'Business Desk',tools:'AI Tools'})[id]||id;window.scrollTo(0,0)}
function addMsg(text,who='ai',imageUrl=null){const box=document.getElementById('messages');const welcome=document.getElementById('welcome');if(welcome)welcome.remove();const el=document.createElement('div');el.className='msg '+who;const label=document.createElement('div');label.className='who';label.textContent=who==='user'?'YOU':'USAID ASSISTANT';el.appendChild(label);const body=document.createElement('div');body.textContent=text;el.appendChild(body);if(imageUrl){const im=document.createElement('img');im.src=imageUrl;im.style.maxWidth='210px';im.style.display='block';im.style.marginTop='10px';im.style.borderRadius='10px';el.appendChild(im)}box.appendChild(el);box.scrollTop=box.scrollHeight}
function sendMessage(){const input=document.getElementById('chatInput');const text=input.value.trim();if(!text&&!attachedData)return;addMsg(text||'I attached an image.', 'user',attachedData);input.value='';attachedData=null;document.getElementById('attachment').textContent='';setTimeout(()=>addMsg('Your message has been added to this demo chat. To answer like ChatGPT—with explanations, study help, business guidance and image understanding—USAID AI still needs a secure AI model connection. The chat interface is ready; the live AI brain is not connected yet.'),350)}
function attachImage(e){const f=e.target.files&&e.target.files[0];if(!f)return;if(!f.type.startsWith('image/'))return;attachedData=URL.createObjectURL(f);document.getElementById('attachment').textContent='Image ready to send: '+f.name}
function newChat(){document.getElementById('messages').innerHTML='<div class="welcome" id="welcome"><div class="orb">✦</div><h2>How can I help today?</h2><p>Ask about study, ideas, business, writing or technology. You can also attach a picture.</p></div>';attachedData=null;document.getElementById('attachment').textContent='';showPage('chat')}
function prepare(inputId,label){const v=document.getElementById(inputId).value.trim();document.getElementById(inputId.replace('Text','Out').replace('Prompt','Out')).textContent=v?label+' ready:\n'+v:'Please enter your request first.'}
function previewImage(e){const f=e.target.files&&e.target.files[0];if(!f)return;const im=document.getElementById('imagePreview');im.src=URL.createObjectURL(f);im.hidden=false}
function listen(){const R=window.SpeechRecognition||window.webkitSpeechRecognition;if(!R){document.getElementById('voiceInput').textContent='Speech recognition is not supported in this browser. Try a supported browser.';return}const r=new R();r.lang='ur-PK';r.onresult=e=>document.getElementById('voiceInput').textContent=e.results[0][0].transcript;r.onerror=()=>document.getElementById('voiceInput').textContent='Could not recognize speech. Check microphone permission.';r.start()}
function speak(){const t=document.getElementById('speakText').value.trim();if(!t)return;if(!('speechSynthesis'in window)){alert('Speech is not supported in this browser.');return}speechSynthesis.cancel();speechSynthesis.speak(new SpeechSynthesisUtterance(t))}
function businessPlan(){const n=document.getElementById('bizName').value.trim(),v=document.getElementById('bizText').value.trim();document.getElementById('bizOut').textContent=n||v?'Project: '+(n||'Not named')+'\nGoal: '+(v||'Add your goal')+'\n\nThis is a prepared bri
